# Google Gemini API Key (obtener gratuitamente en https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo de embeddings de Gemini
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Dimensiones MRL (Matryoshka): 768, 1536 o 3072 (recomendadas por Google)
EMBEDDING_DIMENSIONS="768"

# Ruta para la base de datos vectorial persistente ChromaDB
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# Directorio por defecto para medios a indexar
DEFAULT_MEDIA_DIR="./media"
